# 复制成 .env 后填值。不要提交 .env。
# --- 模型 ---
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-key-here

# --- 路径（容器里用 samples/，本地可留空自动探测）---
# PDC_REPO=samples/pipelines
# PDC_RULES_DIR=samples/rules
# PDC_SKILLS_DIR=samples/skills
# PDC_OUT_DIR=out

# --- 检索 ---
PDC_RAG_MODE=bm25          # bm25 | hybrid
PDC_RAG_ALPHA=0.1

# --- 并发 ---
PDC_MAX_CONCURRENCY=4
